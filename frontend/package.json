{
  "name": "frontend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run codegen:watch\" \"next dev --turbopack\"",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "codegen": "graphql-codegen --config scripts/codegen.ts",
    "codegen:watch": "graphql-codegen --config scripts/codegen.ts --watch src/graphql/**/*.ts",
    "prestart": "npm run codegen",
    "prebuild": "npm run codegen"
  },
  "dependencies": {
    "@apollo/client": "^4.0.7",
    "cross-fetch": "^4.1.0",
    "graphql": "^16.11.0",
    "next": "15.5.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@parcel/watcher": "^2.5.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.5",
    "typescript": "^5"
  }
}
